<?xml version="1.0" encoding="utf-8"?>
<!-- oca-hooks:disable=xml-xpath-translatable-item-->
<odoo>
    <template id="hide_doc_purchase_customer_portal" name="ARTG Customer Portal - Hide RFQ" customize_show="True" inherit_id="purchase.portal_my_home_purchase" priority="25">
        <xpath expr="//t[contains(text(), 'Requests for Quotation')]/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//t[contains(text(), 'Purchase Orders')]/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
